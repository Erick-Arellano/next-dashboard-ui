// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/client"
}

datasource db {
  provider = "sqlite"
}

model Teacher {
  id              String           @id
  name            String
  email           String?          @unique
  phone           String?
  photo           String?
  address         String?
  subjects        Subject[]        @relation("TeacherSubjects")
  classes         Class[]          @relation("TeacherClasses")
  lessons         Lesson[]
  exams           Exam[]
  assignments     Assignment[]
  results         Result[]
  teacherPayments TeacherPayment[]
  evaluations     Evaluation[]
  reportCards     ReportCard[]
}

model Student {
  id       String   @id
  name     String
  email    String?  @unique
  phone    String?
  photo    String?
  address  String?
  grade    Int
  classId  String?
  class    Class?   @relation(fields: [classId], references: [id])
  payments Payment[]
  results  Result[]
  reportCards ReportCard[]
}

model Subject {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  teachers    Teacher[]    @relation("TeacherSubjects")
  lessons     Lesson[]
  exams       Exam[]
  assignments Assignment[]
  results     Result[]
}

model Class {
  id           String       @id
  name         String       @unique
  capacity     Int
  minCapacity  Int          @default(3)
  maxCapacity  Int          @default(8)
  grade        Int
  supervisorId String?
  supervisor   Teacher?     @relation("TeacherClasses", fields: [supervisorId], references: [id])
  students     Student[]
  lessons      Lesson[]
  exams        Exam[]
  assignments  Assignment[]
  results      Result[]
  evaluations  Evaluation[]
  reportCards  ReportCard[]
  whatsappLink String?
}

model Lesson {
  id        Int     @id @default(autoincrement())
  subjectId Int
  subject   Subject @relation(fields: [subjectId], references: [id])
  classId   String
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id])
  dayOfWeek String? // e.g. "Lunes", "Martes", etc.
  startTime String? // e.g. "08:00"
  endTime   String? // e.g. "08:45"
}

model Exam {
  id        Int      @id @default(autoincrement())
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  date      DateTime
  results   Result[]
}

model Assignment {
  id        Int      @id @default(autoincrement())
  subjectId Int
  subject   Subject  @relation(fields: [subjectId], references: [id])
  classId   String
  class     Class    @relation(fields: [classId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  dueDate   DateTime
  results   Result[]
}

model Result {
  id           Int         @id @default(autoincrement())
  subjectId    Int
  subject      Subject     @relation(fields: [subjectId], references: [id])
  studentId    String
  student      Student     @relation(fields: [studentId], references: [id])
  score        Int
  teacherId    String
  teacher      Teacher     @relation(fields: [teacherId], references: [id])
  classId      String
  class        Class       @relation(fields: [classId], references: [id])
  date         DateTime
  examId       Int?
  exam         Exam?       @relation(fields: [examId], references: [id])
  assignmentId Int?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id])
}

model Event {
  id        Int      @id @default(autoincrement())
  title     String
  classId   String?
  date      DateTime
  startTime String
  endTime   String
}

model Announcement {
  id          Int      @id @default(autoincrement())
  title       String
  description String   @default("")
  classId     String?
  date        DateTime
}

model Payment {
  id          Int          @id @default(autoincrement())
  studentId   String
  student     Student      @relation(fields: [studentId], references: [id])
  amount      Float
  hours       Float        @default(0) // Horas pagadas
  type        String       // "Mensual", "Por horas", "Curso completo"
  status      String       // "Pagado", "Pendiente", "Atrasado"
  dueDate     DateTime
  paymentDate DateTime?
  method      String?
  transaction Transaction?
}

model TeacherPayment {
  id          Int          @id @default(autoincrement())
  teacherId   String
  teacher     Teacher      @relation(fields: [teacherId], references: [id])
  amount      Float
  type        String       // "Pago por Horas", "Sueldo Fijo"
  hours       Float
  status      String       // "Pagado", "Pendiente"
  paymentDate DateTime?
  method      String?
  transaction Transaction?
}

model Lead {
  id              Int       @id @default(autoincrement())
  matricula       String?   // Si se convierte en alumno
  name            String    // Nombre del prospecto
  language        String?   // Idioma de interés
  level           String?   // Nivel de interés (A1, A2, etc.)
  age             String?   // Edad (ej. "17.0", "-", "18+")
  phone           String?   // Número de contacto
  contactMethod   String?   // Canal de contacto (Whatsapp, Instagram, Visita, etc.)
  leadDate        DateTime? // Fecha de captación
  sampleClassDate DateTime? // Fecha de clase muestra
  status          String    // ESTATUS: NUEVO, CONTACTADO, CLASE_MUESTRA, LISTA_ESPERA, INSCRITO, NO_INTERESADO
  notes           String?   // Razón por la que no continúa / Notas generales
  createdAt       DateTime  @default(now())
}

enum TransactionType {
  INCOME
  EXPENSE
}

model Transaction {
  id               Int             @id @default(autoincrement())
  amount           Float
  type             TransactionType
  category         String          // "Mensualidad", "Inscripción", "Nómina", "Servicios", "Materiales", etc.
  date             DateTime        @default(now())
  description      String
  
  paymentId        Int?            @unique
  payment          Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  
  teacherPaymentId Int?            @unique
  teacherPayment   TeacherPayment? @relation(fields: [teacherPaymentId], references: [id], onDelete: SetNull)

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Evaluation {
  id            Int      @id @default(autoincrement())
  date          DateTime @default(now())
  
  classId       String
  class         Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacherId     String
  teacher       Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  
  q1_dinamica   Int      // ¿Qué tan dinámica y entretenida fue la clase?
  q2_recursos   Int      // ¿Utilizó diferentes actividades y recursos?
  q3_claridad   Int      // ¿La explicación de los temas fue clara?
  q4_escuchado  Int      // ¿Qué tan escuchado(a) y tomado(a) en cuenta te sentiste?
  q5_participa  Int      // ¿Fomentó la participación de todos?
  q6_dudas      Int      // ¿Se resolvieron tus dudas de forma clara?
  q7_puntual    Int      // ¿Llegó puntual y aprovechó el tiempo?
  q8_interes    Int      // ¿Mostró interés en tu avance y aprendizaje?
  q9_material   Int      // ¿El material utilizado fue útil?
  q10_relevante Int      // ¿El contenido fue relevante?
  q11_global    Int      // En general, ¿Qué tan satisfecho(a) estás con el profesor?
  
  likedText     String   @default("") // Lo que más gustó
  improveText   String   @default("") // Lo que podría mejorar
}

model ReportCard {
  id           Int      @id @default(autoincrement())
  studentId    String
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  teacherId    String
  teacher      Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  classId      String
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  dateText     String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  reading      Int
  grammar      Int
  listening    Int
  speaking     Int
  total        Int
  
  observations String
}
